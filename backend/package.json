{
  "name": "smart-greenhouse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Smart Greenhouse dashboard (mock JSON or MongoDB on the Raspberry Pi)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.js",
    "mock:generate": "tsc -p tsconfig.json && node dist/scripts/generateMockData.js",
    "check:mongo": "node scripts/check-mongo.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}