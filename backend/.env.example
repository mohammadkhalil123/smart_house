# Copy this file to ".env" (never commit ".env") and adjust the values.

# TCP port and interface the API listens on.
# 127.0.0.1 = reachable from this PC only (recommended). If you change PORT,
# set BACKEND_PORT to the same value when starting the Angular dev server.
PORT=3000
HOST=127.0.0.1

# "mock"    -> read backend/data/Measures.json and backend/data/Sprinkler.json (demo data)
# "mongodb" -> read the real database on the Raspberry Pi
DATA_SOURCE=mock   # set to mongodb on the university machine

# Only used when DATA_SOURCE=mongodb. Keep credentials here, never in source code.
# Example shape: mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
MONGODB_URI=
# Real database name, e.g. Rpi07. "RpiXX" is a placeholder and is rejected in mongodb mode.
MONGODB_DATABASE=Rpi29

# IANA time zone in which the Raspberry Pi wrote the "date" and "date_hour" fields.
MEASUREMENT_TIME_ZONE=Europe/Paris

# Optional, mock mode only: pretend "now" is this instant when computing the current
# sprinkler state, so the demo data can show an ON state. ISO 8601; without an offset it
# is read in MEASUREMENT_TIME_ZONE. Leave empty to use the real system clock.
# Example (a sprinkler activation runs at 14:45:50 on 10-11-2026 in the demo data):
# MOCK_NOW=2026-11-10T14:45:55
MOCK_NOW=

# Optional: browser origins allowed to call the API (comma-separated), e.g. http://localhost:4200
# Leave empty when the Angular dev server proxies /api (see DEPLOY.md).
CORS_ORIGINS=
